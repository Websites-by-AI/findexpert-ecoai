# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Website
SITE_URL=https://findexpert.ir

# Telegram bot — create with @BotFather, add the bot as channel admin
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_IDS=

# Bale bot — create at https://ble.ir/botfather  API: https://tapi.bale.ai
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
BALE_CHANNEL_IDS=

# Comma-separated numeric user ids allowed to run /digest (empty = anyone)
BOT_ADMIN_IDS=

# Channel auto-post every N minutes (default 6 hours)
CHANNEL_POST_INTERVAL_MINUTES=360
CHANNEL_TOPIC=environmental grants, university-industry collaboration, green tech, Iran

# HTTPS host for Telegram webhooks (Cloudflare Worker / tunnel). Empty = long-poll (dies when this gate stops).
# Example: https://findexpert-bot.YOURSUBDOMAIN.workers.dev
PUBLIC_URL=
BOT_PORT=8787
BOT_DEFAULT_LANG=fa
